import random
import time

# Function to print text slowly
def print_slow(text):
    """Print text slowly for effect."""
    for letter in text:
        print(letter, end='', flush=True)
        time.sleep(0.03)
    print()

def greet_customer(lives):
    """Handle customer interaction."""
    print_slow("\nA hungry customer walks up to the counter!")
    print_slow("Customer: 'I’d like to place an order!'")
    
    wants_drink = random.choice([True, False])
    
    if wants_drink:
        print_slow("Customer: 'I'd like a drink with my order.'")
    else:
        print_slow("Customer: 'No drink for me today.'")
    
    take_order(lives, wants_drink)

def take_order(lives, wants_drink):
    """Take the customer's order with customization."""
    
    patty_ingredients = ["Lettuce", "Tomato", "Cheese", "Pickles", "Onions", "Bacon"]
    customer_ingredients = random.sample(patty_ingredients, random.randint(1, len(patty_ingredients)))
    print_slow(f"Customer: 'I'd like my Krabby Patty with: {', '.join(customer_ingredients)}.'")
    
    print_slow("Make the customer's order by choosing the correct ingredients.")
    print_slow(", ".join(patty_ingredients))
    chosen_ingredients = input("Your choices: ").split(',')
    chosen_ingredients = [ingredient.strip() for ingredient in chosen_ingredients]
    
    valid_ingredients = [ingredient for ingredient in chosen_ingredients if ingredient in patty_ingredients]
    
    if set(valid_ingredients) != set(customer_ingredients):
        print_slow("The customer frowns at the incorrect ingredients. You lose a life.")
        lives -= 1
    
    print_slow(f"You’ve made a Krabby Patty with: {', '.join(valid_ingredients)}.")
    
    if wants_drink:
        drink_choice = input("Would you like to add a drink? (y/n): ").lower()
        if drink_choice != "y":
            print_slow("You forgot the drink! The customer looks annoyed. You lose a life.")
            lives -= 1
    else:
        drink_choice = input("Would you like to add a drink? (y/n): ").lower()
        if drink_choice == "y":
            print_slow("The customer didn't want a drink! You lose a life.")
            lives -= 1
    
    serve_order(lives)

def serve_order(lives):
    """Serve the order to the customer."""
    print_slow("You hand the order to the customer.")
    print_slow("Customer: 'Thanks! Have a great day!'")
    
    if random.random() < 0.3:
        plankton_attack(lives)
    else:
        print_slow("The Krusty Krab is running smoothly.")

def plankton_attack(lives):
    """Plankton tries to steal the secret formula."""
    print_slow("Plankton sneaks into the kitchen!")
    choice = input("What will you do? (1) Chase him out (2) Ignore him: ")
    
    if choice == "1":
        print_slow("You chase Plankton away and save the formula!")
    else:
        print_slow("Plankton steals the formula! GAME OVER!")
        game_over()

def game_over():
    """End the game."""
    print_slow("GAME OVER!")
    choice = input("Play again? (y/n):\n ")
    if choice.lower() == "y":
        start_game()
    else:
        print_slow("Thanks for playing! Goodbye!")
        exit()

def start_game():
    """Start the game."""
    lives = 4
    print_slow("Welcome to the Krusty Krab!")
    print_slow("Serve customers and protect the secret formula!")
    
    while lives > 0:
        greet_customer(lives)
    
    game_over()

# Start the game
start_game()

