import random
import time

# Function to print text slowly
def print_slow(str):
    """Print text slowly for effect."""
    for letter in str:
        print(letter, end='', flush=True)
        time.sleep(0.04)
    print()

def greet_customer(lives):
    """Handle customer interaction."""
    print_slow("A hungry customer walks up to the counter!")
    print_slow("Customer: 'I’ll have a Krabby Patty with a drink!'")
    
    choice = input("What would you like to do? (1) 'Take the order' (2) 'Ask if they want a drink?' \n")
    
    if choice == "1":
        take_order(lives)
    elif choice == "2":
        take_order_with_drink(lives)
    else:
        print_slow("That’s not a valid option! The customer walks away in frustration.")
        greet_customer(lives)

def take_order(lives):
    """Take the Krabby Patty order and let the customer customize it."""
    print_slow("Customer: 'I want a Krabby Patty with the works!'")
    
    patty_ingredients = ["Lettuce", "Tomato", "Cheese", "Pickles", "Onions", "Bacon"]
    
    print_slow("Which ingredients would you like to add to the Krabby Patty? (You can choose multiple options.)")
    print_slow("Available ingredients: Lettuce, Tomato, Cheese, Pickles, Onions, Bacon")
    
    # Let the customer choose ingredients
    chosen_ingredients = input("Enter your choices, separated by commas: ").split(',')
    chosen_ingredients = [ingredient.strip() for ingredient in chosen_ingredients]

    # Checking if the customer chose valid ingredients
    valid_ingredients = [ingredient for ingredient in chosen_ingredients if ingredient in patty_ingredients]
    
    if valid_ingredients:
        print_slow(f"You’ve made a Krabby Patty with: {', '.join(valid_ingredients)}.")
    else:
        print_slow("The customer is unhappy with the selection. You scramble to make a basic Krabby Patty.")
    
    serve_patty(lives)

def take_order_with_drink(lives):
    """Take the Krabby Patty and drink order with customization."""
    print_slow("Customer: 'I want a Krabby Patty, and I would like a Kelp Juice too!'")
    
    # Kelp Juice customization
    print_slow("How many ice cubes would you like in your Kelp Juice?")
    ice_cubes = input("Enter a number (1-5): ")
    
    try:
        ice_cubes = int(ice_cubes)
        if 1 <= ice_cubes <= 5:
            print_slow(f"The customer’s Kelp Juice has {ice_cubes} ice cubes.")
        else:
            print_slow("The customer frowns. They only wanted 1 to 5 ice cubes. You settle on 3.")
            ice_cubes = 3
    except ValueError:
        print_slow("Invalid input! You default to 3 ice cubes.")
        ice_cubes = 3
    
    # Now take the Krabby Patty order as usual
    patty_ingredients = ["Lettuce", "Tomato", "Cheese", "Pickles", "Onions", "Bacon"]
    
    print_slow("Which ingredients would you like to add to the Krabby Patty? (You can choose multiple options.)")
    print_slow("Available ingredients: Lettuce, Tomato, Cheese, Pickles, Onions, Bacon")
    
    # Let the customer choose ingredients
    chosen_ingredients = input("Enter your choices, separated by commas: ").split(',')
    chosen_ingredients = [ingredient.strip() for ingredient in chosen_ingredients]

    # Checking if the customer chose valid ingredients
    valid_ingredients = [ingredient for ingredient in chosen_ingredients if ingredient in patty_ingredients]
    
    if valid_ingredients:
        print_slow(f"You’ve made a Krabby Patty with: {', '.join(valid_ingredients)}.")
    else:
        print_slow("The customer is unhappy with the selection. You scramble to make a basic Krabby Patty.")
    
    serve_patty(lives)

def serve_patty(lives):
    """Serve the Krabby Patty to the customer."""
    print_slow("You hand the customer the Krabby Patty and their drink with a smile.")
    print_slow("Customer: 'Yum, this is great! Thanks!'")
    
    # Random chance for Plankton to show up
    if random.random() < 0.3:
        plankton_attack(lives)
    else:
        print_slow("Everything seems to be running smoothly at the Krusty Krab.")

def plankton_attack(lives):
    """Plankton tries to steal the secret formula."""
    print_slow("Just as you’re about to take a break, Plankton sneaks into the kitchen!")
    print_slow("Plankton: 'You fools! I’m here to steal the Krabby Patty secret formula!'")
    
    choice = input("What will you do? (1) 'Chase him out!' (2) 'Pretend you don’t see him.'\n")
    
    if choice == "1":
        print_slow("You chase Plankton around the Krusty Krab.")
        print_slow("In the chaos, the formula is safe, and Plankton runs away!")
        print_slow("Customer: 'Phew, that was close!'")
    elif choice == "2":
        print_slow("Plankton sneaks into the back, stealing the secret formula.")
        print_slow("You lose a life!")
        lives -= 1
        if lives <= 0:
            game_over()
        else:
            print_slow(f"You have {lives} lives remaining.")
            print_slow("The Krusty Krab has to shut down for the day!")
            game_over()
    else:
        print_slow("That’s not a valid option! Plankton successfully steals the formula.")
        lives -= 1
        if lives <= 0:
            game_over()
        else:
            print_slow(f"You have {lives} lives remaining.")
            print_slow("The Krusty Krab has to shut down for the day!")
            game_over()

def game_over():
    """End the game."""
    print_slow("GAME OVER!")
    choice = input("Would you like to play again? (y/n): ")
    if choice.lower() == "y":
        start_game()
    else:
        print_slow("Thanks for playing! Goodbye!")
        exit()

def start_game():
    """Start the game."""
    lives = 3
    print_slow("Welcome to the Krusty Krab! SpongeBob is sick today, and you’re filling in!")
    print_slow("Your goal is to serve Krabby Patties to customers and keep the restaurant running smoothly.")
    print_slow("But be careful! Plankton may show up and steal the secret formula.")
    
    # Main game loop
    while lives > 0:
        greet_customer(lives)

    # If lives are 0, the game ends
    print_slow("You have no more lives left. The game is over.")
    game_over()

# Start the game
start_game()

